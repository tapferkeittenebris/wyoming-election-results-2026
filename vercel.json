{
  "cleanUrls": true,
  "alias": [
    "buckthefreedomcaucus.wtf",
    "www.buckthefreedomcaucus.wtf"
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.buckthefreedomcaucus.wtf"
        }
      ],
      "destination": "https://buckthefreedomcaucus.wtf/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source": "/", "destination": "/index-swapped.html"},
    {"source": "/advertise", "destination": "/advertise.html"},
    {"source": "/privacy", "destination": "/privacy.html"}
  ],
  "headers": [
    {"source": "/(.*)", "headers": [{"key": "Cache-Control", "value": "no-store, max-age=0"}]}
  ]
}
