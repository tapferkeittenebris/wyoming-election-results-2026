{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{"type":"host","value":"www.buckthefreedomcaucus.wtf"}],
      "destination": "https://buckthefreedomcaucus.wtf/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {"source": "/results.json", "destination": "/api/results"},
    {"source": "/", "destination": "/index.html"},
    {"source": "/advertise", "destination": "/advertise.html"},
    {"source": "/privacy", "destination": "/privacy.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {"key": "X-Content-Type-Options", "value": "nosniff"},
        {"key": "Referrer-Policy", "value": "strict-origin-when-cross-origin"}
      ]
    }
  ]
}
